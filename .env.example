# Anthropic API key for AI scoring engine
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Admin API key — any random string. Required on X-Admin-Key header for /admin/* endpoints.
ADMIN_API_KEY=generate-a-random-string-here

# Port (Railway sets this automatically)
PORT=8000

# UTC hour for daily scoring refresh (0-23)
SCORING_CRON_HOUR=6

# SQLite database path
DATABASE_PATH=energy_risk.db

# Anthropic model used for scoring
ANTHROPIC_MODEL=claude-opus-4-7

# Batch size for AI scoring calls. Default 1 keeps each API call well under
# Anthropic Tier 1's 30k input-tokens-per-minute limit. Full 62-country run
# takes ~62 minutes on Tier 1. Once your account auto-upgrades to Tier 2
# (450k TPM — usually after $40 cumulative spend + 7 days), you can bump
# this to 5 or 10 and drop INTER_BATCH_SLEEP_SEC in scoring.py to ~15s.
SCORING_BATCH_SIZE=1
